@{
    Layout = "/Views/Shared/_Layout_Auth.cshtml";
    ViewBag.Title = "Đăng nhập";
}

<div class="relative w-full max-w-md">
    <div class="absolute -top-10 -left-10 w-44 h-44 bg-blue-100 rounded-full blur-3xl opacity-60 pointer-events-none"></div>

    <div class="absolute -bottom-8 -right-8 w-44 h-44 bg-indigo-100 rounded-full blur-3xl opacity-40 pointer-events-none"></div>

    <div class="relative bg-white rounded-2xl shadow-xl border border-slate-200/80 p-6 sm:p-8">
        <div class="flex flex-col items-center text-center">
            <div class="w-14 h-14 rounded-xl bg-blue-50 flex items-center justify-center shadow-sm text-blue-600 mb-4">
                @Html.Icon("verified_user", "w-[36px] h-[36px] text-xl text-base shrink-0")
            </div>

            <span class="text-xs text-slate-500 font-semibold uppercase tracking-wider mb-1.5">
                AI DBA Agent
            </span>

            <h1 class="text-2xl text-slate-900 font-bold tracking-tight mb-2">
                Log In
            </h1>

            <p class="text-sm text-slate-600 max-w-xs leading-relaxed">
                Sign in with your employee account to access the system.
            </p>
        </div>

        @using (Html.BeginForm("Login", "Auth", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            <div class="mt-6 space-y-4">

                <input type="hidden"
                       name="returnUrl"
                       value="@ViewBag.ReturnUrl" />

                <div class="mb-3">
                    <label class="block text-sm text-slate-800 font-semibold mb-1.5"
                           for="badge-id">
                        Username
                    </label>

                    <div class="relative flex items-center">
                        <span class="absolute left-3.5 flex items-center justify-center pointer-events-none text-slate-400">
                            @Html.Icon("person", "w-[22px] h-[22px] text-xl text-base shrink-0")
                        </span>

                        <input autocomplete="username"
                               class="w-full pl-11 pr-4 py-2.5 bg-slate-50 border border-slate-200 rounded-lg text-sm text-slate-900 placeholder:text-slate-400 transition-colors focus:bg-white focus:border-blue-500 focus:shadow-sm focus:outline-none"
                               id="badge-id"
                               name="username"
                               placeholder="Employee ID"
                               required=""
                               type="text">
                    </div>
                </div>

                <div class="mb-3">
                    <div class="flex items-center justify-between mb-1.5">
                        <label class="block text-sm text-slate-800 font-semibold"
                               for="password-input">
                            Password
                        </label>

                        @*<a class="text-xs text-blue-600 hover:text-blue-700 font-semibold transition-colors"
                               href="#">
                                Quên mật khẩu?
                            </a>*@
                    </div>

                    <div class="relative flex items-center">
                        <span class="absolute left-3.5 flex items-center justify-center pointer-events-none text-slate-400">
                            @Html.Icon("lock", "w-[22px] h-[22px] text-xl text-base shrink-0")
                        </span>

                        <input autocomplete="current-password"
                               class="w-full pl-11 pr-11 py-2.5 bg-slate-50 border border-slate-200 rounded-lg text-sm text-slate-900 placeholder:text-slate-400 transition-colors focus:bg-white focus:border-blue-500 focus:shadow-sm focus:outline-none"
                               id="password-input"
                               name="password"
                               placeholder="********"
                               required=""
                               type="password">

                        <button aria-label="Ẩn hoặc hiện mật khẩu"
                                class="absolute right-3.5 p-1 flex items-center justify-center text-slate-400 hover:text-slate-700 transition-colors cursor-pointer rounded"
                                id="toggle-password"
                                type="button">
                            @Html.Icon("visibility", "w-[18px] h-[18px] text-xl text-base shrink-0")
                        </button>
                    </div>
                </div>

                <div class="mt-5 pt-2">
                    <button class="w-full py-3 px-6 bg-blue-600 hover:bg-blue-700 text-white text-sm font-semibold rounded-lg shadow-sm transition duration-200 flex items-center justify-center gap-2 cursor-pointer focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2"
                            id="login-btn"
                            type="submit">
                        <span class="">Log in</span>
                    </button>
                </div>

                @if (ViewBag.Error != null)
                {
                    <div class="mt-4 px-3 py-2 text-center rounded-md text-sm bg-rose-500/20 text-rose-600">
                        @ViewBag.Error
                    </div>
                }
            </div>
        }

        <div class="mt-6 pt-6 border-t border-slate-100 bg-white flex flex-col items-center text-center">
            <div class="flex items-center gap-1.5 justify-center text-blue-600 mb-1">
                @Html.Icon("bolt", "w-[1.25rem] h-[1.25rem] text-base shrink-0")
                <span class="text-xs font-semibold uppercase tracking-wider">
                    Powered by QMH - QMS
                </span>
            </div>

            <p class="text-xs text-slate-500 leading-relaxed">
                Email
                <a class="text-blue-600 hover:text-blue-700 font-medium hover:underline"
                   href="mailto:qmhqms@quantacn.com">
                    qmhqms@quantacn.com
                </a>
            </p>
        </div>
    </div>
</div>
<script>
    document.addEventListener('DOMContentLoaded', function () {
        const passwordInput = document.getElementById("password-input");
        const toggleBtn = document.getElementById("toggle-password");

        if (!passwordInput || !toggleBtn) return;

        toggleBtn.addEventListener("click", function () {

            const isPassword =
                passwordInput.getAttribute("type") === "password";

            passwordInput.setAttribute(
                "type",
                isPassword ? "text" : "password"
            );

            toggleBtn.innerHTML = isPassword
                ? '@Html.Raw(Html.Icon("visibility_off", "w-[18px] h-[18px] shrink-0"))'
                : '@Html.Raw(Html.Icon("visibility", "w-[18px] h-[18px] shrink-0"))';
        });
    });
</script>
