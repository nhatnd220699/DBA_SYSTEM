@{
    string cookieToken, formToken;
    System.Web.Helpers.AntiForgery.GetTokens(null, out cookieToken, out formToken);
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="app-root" content="@Url.Content("~/")" />
    <meta name="csrf-form-token" content="@formToken" />
    <title>@ViewBag.Title - AI DBA Agent</title>
    <link rel="icon" type="image/svg+xml" href="@Url.Content("~/Content/images/favicon/robot.svg")" />
    <link rel="stylesheet" href="@Url.Content("~/Content/dist/app.min.css")" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <script>
        window.appRoot = '@Url.Content("~/")';
    </script>
    @*<script src="@Url.Content("~/Scripts/libs/tailwind/tailwind.js")"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        noc: {
                            canvas: '#040810',
                            panel: '#09101c',
                            card: '#0e1726',
                            inner: '#142033',
                            accent: '#38bdf8',
                            success: '#34d399',
                            warning: '#fbbf24',
                            danger: '#f43f5e',
                        },
                    },
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                        mono: ['JetBrains Mono', 'monospace'],
                    },
                },
            },
        };
    </script>
    <style>


        :root {
            --scrollbar-track: #e2e8f0; /* slate-200 */
            --scrollbar-thumb: #94a3b8; /* slate-400 */
            --scrollbar-hover: #0284c7; /* sky-600 */
        }

        html.dark {
            --scrollbar-track: #09101c;
            --scrollbar-thumb: #1e293b;
            --scrollbar-hover: #38bdf8;
        }

        body {
            background-color: #040810;
            color: #f1f5f9;
            overflow-x: hidden;
        }

        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }

        ::-webkit-scrollbar-track {
            background: var(--scrollbar-track);
        }

        ::-webkit-scrollbar-thumb {
            background: var(--scrollbar-thumb);
            border-radius: 4px;
        }

            ::-webkit-scrollbar-thumb:hover {
                background: var(--scrollbar-hover);
            }
    </style>*@
    @RenderSection("styles", required: false)
</head>
<body class="min-h-screen bg-slate-100 dark:bg-[#252d3d]
             font-sans text-sm text-slate-900 dark:text-slate-100
             selection:bg-cyan-100 selection:text-cyan-900
             dark:selection:bg-cyan-500/20 dark:selection:text-cyan-300">
    @Html.Partial("_Navbar")
    @Html.Partial("_Sidebar")
    <div class="w-full">
        @RenderBody()
    </div>
    @RenderSection("scripts", required: false)
</body>
</html>
