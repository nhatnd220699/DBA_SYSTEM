    <script>
        document.addEventListener('DOMContentLoaded', () => {
            // Elements
            const sidebar = document.getElementById('mainSidebar');
            const sidebarOverlay = document.getElementById('sidebarOverlay');
            const sidebarToggleBtn = document.getElementById('sidebarToggleBtn');
            const sidebarCloseBtn = document.getElementById('sidebarCloseBtn');

            // 1. SIDEBAR TOGGLE & CLOSE
            function openSidebar() {
                sidebar.classList.remove('-translate-x-full');
                sidebarOverlay.classList.remove('hidden');
                setTimeout(() => {
                    sidebarOverlay.classList.remove('opacity-0');
                    sidebarOverlay.classList.add('opacity-100');
                }, 10);
            }

            function closeSidebar() {
                sidebar.classList.add('-translate-x-full');
                sidebarOverlay.classList.remove('opacity-100');
                sidebarOverlay.classList.add('opacity-0');
                setTimeout(() => {
                    sidebarOverlay.classList.add('hidden');
                }, 300);
            }

            if (sidebarToggleBtn) {
                sidebarToggleBtn.addEventListener('click', (e) => {
                    e.stopPropagation();
                    if (sidebar.classList.contains('-translate-x-full')) {
                        openSidebar();
                    } else {
                        closeSidebar();
                    }
                });
            }

            if (sidebarCloseBtn) {
                sidebarCloseBtn.addEventListener('click', closeSidebar);
            }

            if (sidebarOverlay) {
                sidebarOverlay.addEventListener('click', closeSidebar);
            }


            // 2. MULTI-LEVEL ACCORDION & DEEP PARENT-CHILD RECURSIVE HIGHLIGHTING
            const accordionToggles = document.querySelectorAll('.accordion-toggle');
            accordionToggles.forEach((toggle) => {
                toggle.addEventListener('click', function (e) {
                    e.preventDefault();
                    e.stopPropagation();
                    const parent = this.parentElement;
                    const submenu = parent.querySelector(':scope > .submenu-container');
                    const chevron = this.querySelector('.chevron-icon');

                    if (submenu) {
                        const isHidden = submenu.classList.contains('hidden');
                        if (isHidden) {
                            submenu.classList.remove('hidden');
                            if (chevron) chevron.classList.add('rotate-180');
                        } else {
                            submenu.classList.add('hidden');
                            if (chevron) chevron.classList.remove('rotate-180');
                        }
                    }
                });
            });

            // Nav Leaf Items click: Highlight Leaf AND Highlight ALL Parent Accordion Tiers
            const navLeaves = document.querySelectorAll('.nav-leaf');
            navLeaves.forEach((leaf) => {
                leaf.addEventListener('click', function (e) {
                    e.preventDefault();

                    // Reset all leaves
                    navLeaves.forEach((item) => {
                        item.classList.remove(
                            'bg-sky-500/20',
                            'text-sky-300',
                            'border-l-2',
                            'border-sky-400',
                            'font-semibold',
                        );
                        item.classList.add('text-on-surface-variant');
                    });

                    // Reset all parent headers
                    document.querySelectorAll('.level-1-header, .level-2-header').forEach((header) => {
                        header.classList.remove('bg-surface-container-high', 'text-primary', 'font-bold');
                        header.classList.add('text-on-surface-variant');
                    });

                    // Highlight this leaf
                    this.classList.remove('text-on-surface-variant');
                    this.classList.add(
                        'bg-sky-500/20',
                        'text-sky-300',
                        'border-l-2',
                        'border-sky-400',
                        'font-semibold',
                    );

                    // Traverse UP the DOM tree to expand and highlight parents
                    let current = this.parentElement;
                    while (current && current !== document.getElementById('sidebarNavMenu')) {
                        // If inside a submenu, ensure it's expanded
                        if (current.classList.contains('submenu-container')) {
                            current.classList.remove('hidden');
                            const parentBtn = current.previousElementSibling;
                            if (parentBtn && parentBtn.classList.contains('accordion-toggle')) {
                                const chevron = parentBtn.querySelector('.chevron-icon');
                                if (chevron) chevron.classList.add('rotate-180');
                                parentBtn.classList.remove('text-on-surface-variant');
                                parentBtn.classList.add('bg-surface-container-high', 'text-primary', 'font-bold');
                            }
                        }
                        current = current.parentElement;
                    }
                });
            });
        });
    </script>
