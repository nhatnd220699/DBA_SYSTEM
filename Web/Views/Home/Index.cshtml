                            <div class="space-y-1.5 mt-3 w-full">
                                <div class="font-mono text-base text-center">
                                    <span class="font-bold text-slate-100">2.88</span>
                                    <span class="text-slate-400">/ 3.0 TB</span>
                                </div>
                                <div class="pt-1 text-center">
                                    <span class="inline-block font-mono font-bold text-[12px] text-rose-600 tracking-wide">3.8% Free (Crit)</span>
                                </div>
                            </div>
                        </div>

                        <!-- Ổ B: Backup Local (Healthy) -->
                        <div class="flex flex-col justify-between bg-[#121c2d] hover:bg-[#18263e] shadow-md p-3.5 rounded-xl transition-all duration-200">
                            <div class="flex flex-col items-center w-full text-center">
                                <!-- Backup Drive Visual SVG -->
                                <div class="relative mb-2.5 filter">
                                    <img src="@Url.Content("~/Content/images/hdd_48.png")   " alt="disk" />
                                </div>
                                <span class="font-mono font-bold text-white text-xs tracking-tight">Disk (B:)</span>
                                <!-- <span class="mt-0.5 max-w-full font-sans text-[11px] text-slate-400 truncate"
                                    >Local Dump &amp; Snapshots</span
                                > -->
                            </div>

                            <div class="space-y-1.5 mt-3 w-full">
                                <div class="font-mono text-base text-center">
                                    <span class="font-semibold text-slate-100">2.74</span>
                                    <span class="text-slate-400">/ 5.0 TB</span>
                                </div>
                                <div class="pt-1 text-center">
                                    <span class="inline-block font-mono font-medium text-[12px] text-slate-100 tracking-wide">45.2% Free (2.26 TB)</span>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="hidden grid grid-cols-2 md:grid-cols-4 gap-3 storage-pane transition-opacity duration-300 opacity-0"
                         id="pane-fatp02">
                        Disk 2
                    </div>
                    <div class="hidden grid grid-cols-2 md:grid-cols-4 gap-3 storage-pane transition-opacity duration-300 opacity-0"
                         id="pane-crapp">
                        Disk 3
                    </div>
                    <div class="hidden grid grid-cols-2 md:grid-cols-4 gap-3 storage-pane transition-opacity duration-300 opacity-0"
                         id="pane-smt01">
                        Disk 4
                    </div>
                </div>
            </div>
        </div>
        <!-- Col Right (7 cols): Always On AG Health Status -->
        <div class="flex flex-col justify-between xl:col-span-7 bg-[#0e1726] shadow-md rounded-xl p-4">
            <div>
                <div class="flex justify-between flex-wrap sm:flex-nowrap items-center mb-3">
                    <div class="flex items-center gap-2">
                        @Html.Icon("sync_alt", "w-[18px] h-[18px] text-slate-100 text-base md:text-lg shrink-0")
                        <h2 class="font-sans font-semibold text-slate-100 text-sm md:text-base">
                            Always On AG Health Status
                        </h2>
                    </div>
                    <span class="bg-slate-500/20 shadow-sm px-2.5 py-1.5 rounded font-mono font-medium text-slate-400 text-xs" id="alwayson-badge">S</span>
                </div>
                <div class="bg-[#0a1220]/70 rounded-lg overflow-hidden">
                    <div class="max-h-[240px] overflow-y-auto snap-mandatory snap-y">
                        <table class="w-full font-mono text-xs text-left" id="table-alwayson">
                            <thead class="top-0 z-10 sticky bg-[#09101c] text-[11px] text-slate-400 uppercase tracking-wider">
                                <tr>
                                    <th class="px-3 py-2.5 whitespace-nowrap">DATABASE</th>
                                    <th class="px-3 py-2.5 whitespace-nowrap">REPLICA SERVER</th>
                                    <th class="px-3 py-2.5 whitespace-nowrap">ROLE</th>
                                    <th class="px-3 py-2.5 whitespace-nowrap">CONN</th>
                                    <th class="px-3 py-2.5 whitespace-nowrap">SYNC STATE</th>
                                    <th class="px-3 py-2.5 whitespace-nowrap text-center">HEALTH</th>
                                    <th class="px-3 py-2.5 whitespace-nowrap text-right">LOG QUEUE</th>
                                    <th class="px-3 py-2.5 whitespace-nowrap text-right">REDO QUEUE</th>
                                    <th class="px-3 py-2.5 whitespace-nowrap text-right">LOG RATE</th>
                                    <th class="px-3 py-2.5 whitespace-nowrap text-right">REDO RATE</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-[#142033]/40 text-xs"></tbody>
                        </table>
                    </div>
                </div>
            </div>
            <div class="flex justify-between items-center bg-[#0a1220]/60 -mx-4 mt-3 -mb-4 px-4 py-3 pt-3 rounded-b-xl font-mono text-slate-400 text-xs">
                <span class="shadow-sm px-2.5 py-0.5 rounded font-mono font-semibold text-emerald-400 text-xs">AUTO FAILOVER: ENABLED</span>
                <!-- <span
                    class="bg-emerald-500/20 shadow-sm px-2.5 py-0.5 rounded font-mono font-semibold text-emerald-400 text-xs"
                    >HEALTH CHECK TIMEOUT: 30000ms</span
                > -->
            </div>
        </div>
    </div>
</main>

<!-- Modal -->
<div class="fixed inset-0 bg-black/60 backdrop-blur-sm z-50 hidden flex items-center justify-center p-3 sm:p-5"
     id="subsystem-modal">
    <div class="w-full max-w-[1500px] bg-[#09101c] rounded-2xl shadow-2xl shadow-black border border-slate-800/80 flex flex-col max-h-[92vh] overflow-hidden">
        <!-- Modal Header with Subsystem Switcher Tabs -->
        <div class="p-4 bg-[#0e1726] border-b border-slate-800 flex flex-col gap-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-3">
                    <div class="w-9 h-9 rounded-xl bg-cyan-500/20 text-cyan-300 flex items-center justify-center border border-cyan-500/30"
                         id="modal-subsystem-icon-wrap">
                        @Html.Icon("terminal", "w-[1.25rem] h-[1.25rem] text-xl shrink-0")
                    </div>
                    <div>
                        <div class="flex items-center gap-2">
                            <h3 class="font-sans font-bold text-base text-white" id="modal-subsystem-title">
                                Stored Procedure Failures Cockpit
                            </h3>
                            <!-- <span
                                class="px-2.5 py-0.5 rounded font-mono text-xs font-bold bg-rose-500/20 text-rose-400 border border-rose-500/30"
                                id="modal-subsystem-badge"
                                >50 INCIDENTS • CRIT</span
                            > -->
                        </div>
                        <p class="text-xs text-slate-400 mt-0.5" id="modal-subsystem-desc">
                            Select an incident to view technical root cause, remediation steps, and execute
                            handler dispatch
                        </p>
                    </div>
                </div>
                <button class="p-1.5 rounded-lg text-slate-400 hover:text-white hover:bg-[#152238] transition-colors"
                        onclick="closeSubsystemModal()">
                    @*<span class="material-symbols-outlined text-xl">close</span>*@
                    @Html.Icon("close", "w-[1.25rem] h-[1.25rem] shrink-0")

                </button>
            </div>
            <!-- Navigation tabs between 4 subsystems within modal -->
            <div class="flex items-center gap-2 overflow-x-auto pb-1 text-xs font-mono" id="category-filter-bar">
            </div>
        </div>

        <!-- Filter Toolbar -->
        <div class="grid grid-cols-1 xl:grid-cols-12 gap-3">
            <!-- Severity Filters -->
            <div class="xl:col-span-6 flex flex-wrap items-center gap-1.5 p-1.5" id="severity-filter-bar">
                <!-- Dynamic category tabs rendered by JS -->
            </div>
            <!-- Controls: Search & Expand/Collapse -->
            <div class="xl:col-span-6 flex items-center justify-start xl:justify-end gap-1.5 p-1.5">
                <div class="flex flex-wrap items-center gap-2">
                    <div class="relative flex items-center">
                        @*<span class="material-symbols-outlined absolute left-2 text-[16px] text-slate-500">search</span>*@
                        @Html.Icon("search", "w-[16px] h-[16px] absolute left-2 text-slate-500 shrink-0")

                        <input class="bg-slate-900 pl-8 pr-3 py-1.5 h-8 rounded text-[12px] text-slate-100 placeholder:text-slate-500 focus:outline-none focus:bg-slate-800 border border-slate-700 transition-colors w-64 md:w-72"
                               id="incident-search"
                               placeholder="Filter incidents, SPIDs, errors... (Ctrl+K)"
                               type="text" />
                    </div>
                    <button class="h-8 px-2.5 rounded bg-slate-900 hover:bg-slate-800 text-slate-200 font-medium text-[12px] flex items-center gap-1.5 border border-slate-700 transition-colors"
                            id="btn-expand-all"
                            onclick="expandAll()"
                            type="button">
                        @*<span class="material-symbols-outlined text-[16px] text-blue-400">unfold_more</span>*@
                        @Html.Icon("unfold_more", "w-[16px] h-[16px] text-blue-400 shrink-0")
                        <span>Expand All</span>
                    </button>
                    <button class="h-8 px-2.5 rounded bg-slate-900 hover:bg-slate-800 text-slate-200 font-medium text-[12px] flex items-center gap-1.5 border border-slate-700 transition-colors"
                            id="btn-collapse-all"
                            onclick="collapseAll()"
                            type="button">
                        @*<span class="material-symbols-outlined text-[16px] text-slate-500">unfold_less</span>*@
                        @Html.Icon("unfold_less", "w-[16px] h-[16px] text-blue-400 shrink-0")
                        <span>Collapse All</span>
                    </button>
                </div>
            </div>
        </div>

        <!-- 3-LEVEL HIERARCHICAL ACCORDION CONTAINER -->
        <div class="p-4 sm:p-5 overflow-y-auto space-y-3" id="accordion-root"></div>

        <!-- Modal Dynamic Body Content Container (Scrollable) -->
        <div class="p-4 sm:p-5 overflow-y-auto space-y-4" id="modal-content-area"></div>

        <!-- Modal Footer -->
        <div class="p-3 bg-[#0a1220] border-t border-slate-800/80 flex items-center justify-end font-mono text-xs text-slate-400">
            <!-- <div class="flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                <span>TELEMETRY NOC ENGINE v4.2 • LEVEL 2 DRILL-DOWN READY</span>
            </div> -->
            <button class="px-5 py-3 rounded-lg bg-[#142033] hover:bg-[#1c2e47] text-slate-200 hover:text-white text-xs font-sans font-medium transition-colors uppercase"
                    onclick="closeSubsystemModal()">
                Close
            </button>
        </div>
    </div>
</div>


<!-- ==================== TOAST NOTIFICATION CONTAINER ==================== -->
<div class="right-5 bottom-5 z-50 fixed flex flex-col gap-2 pointer-events-none" id="toast-container"></div>

@section Scripts{
    <script type="module" src="@Url.Content("~/Scripts/custom/features/index.js")"></script>
}