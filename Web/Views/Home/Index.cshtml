@{
    ViewBag.Title = "DBA Dashboard";
}

<!-- ==================== MAIN DASHBOARD LAYOUT ==================== -->
<main class="space-y-3 bg-slate-100 dark:bg-[#252d3d] px-4 py-4 w-full">
    <!--#040810-->
    <!-- TOP KPI CARDS -->
    <div class="gap-3 grid grid-cols-2 lg:grid-cols-4">
        <!-- KPI 1: INCIDENT CRITICAL/HIGH -->
        <div class="flex justify-between items-center gap-3 bg-white dark:bg-[#0e1726] rounded-xl shadow-xl px-4 py-8">
            <div class="flex-1 min-w-0">
                <div class="flex justify-between items-center gap-1 mb-1">
                    <span class="font-mono font-semibold text-slate-600 dark:text-slate-400 text-xs uppercase tracking-wider">CRITIAL/HIGH</span>
                </div>
                <div class="font-mono font-bold text-rose-600 dark:text-rose-600 text-xl md:text-3xl tracking-tight" id="kpi-high">
                    0
                </div>
            </div>
            <div class="flex justify-center items-center bg-slate-100 dark:bg-[#16233b] rounded-xl w-9 md:w-12 h-9 md:h-12 text-slate-500 dark:text-slate-400 shrink-0">
                @Html.Icon("warning", "w-[24px] h-[24px] shrink-0")
            </div>
        </div>

        <!-- KPI 2: MEDIUM INCIDENT -->
        <div class="flex justify-between items-center gap-3 bg-white dark:bg-[#0e1726] rounded-xl shadow-xl px-4 py-8">
            <div class="flex-1 min-w-0">
                <div class="flex justify-between items-center gap-1 mb-1">
                    <span class="font-mono font-semibold text-slate-600 dark:text-slate-400 text-xs uppercase tracking-wider">MEDIUM/LOW</span>
                </div>
                <div class="font-mono font-bold text-slate-900 dark:text-slate-100 text-xl md:text-3xl tracking-tight" id="kpi-medium">
                    0
                </div>
            </div>
            <div class="flex justify-center items-center bg-slate-100 dark:bg-[#16233b] rounded-xl w-9 md:w-12 h-9 md:h-12 text-slate-500 dark:text-slate-400 shrink-0">
                @Html.Icon("report", "w-[24px] h-[24px] shrink-0")
            </div>
        </div>

        <!-- KPI 3: CAPACITY INCIDENT -->
        <div class="flex justify-between items-center gap-3 bg-white dark:bg-[#0e1726] rounded-xl shadow-xl px-4 py-8">
            <div class="flex-1 min-w-0">
                <div class="flex justify-between items-center gap-1 mb-1">
                    <span class="font-mono font-semibold text-slate-600 dark:text-slate-400 text-xs uppercase tracking-wider">CAPACITY</span>
                </div>
                <div class="font-mono font-bold text-slate-900 dark:text-slate-100 text-xl md:text-3xl tracking-tight" id="kpi-capcity">
                    0
                </div>
            </div>
            <div class="flex justify-center items-center bg-slate-100 dark:bg-[#16233b] rounded-xl w-9 md:w-12 h-9 md:h-12 text-slate-500 dark:text-slate-400 shrink-0">
                @Html.Icon("hard_drive", "w-[24px] h-[24px] shrink-0")
            </div>
        </div>

        <!-- KPI 4: BACKUP -->
        <div class="flex justify-between items-center gap-3 bg-white dark:bg-[#0e1726] rounded-xl shadow-xl p-5 lg:px-4 lg:py-8">
            <div class="flex-1 min-w-0">
                <div class="flex justify-between items-center gap-1 mb-1">
                    <span class="font-mono font-semibold text-slate-600 dark:text-slate-400 text-xs uppercase tracking-wider">BACKUP</span>
                </div>
                <div class="font-mono font-bold text-slate-900 dark:text-slate-100 text-xl md:text-3xl tracking-tight" id="kpi-backup">
                    0%
                </div>
            </div>
            <div class="flex justify-center items-center bg-slate-100 dark:bg-[#16233b] rounded-xl w-9 md:w-12 h-9 md:h-12 text-slate-500 dark:text-slate-400 shrink-0">
                @Html.Icon("cloud_done", "w-[24px] h-[24px] shrink-0")
            </div>
        </div>
    </div>

    <!-- ROW 1: INCIDENT DISTRIBUTION & DISK CAPACITY -->
    <div class="gap-3 grid grid-cols-1 xl:grid-cols-12">
        <!-- Col Left (5 cols): Errors Summary -->
        <div class="flex flex-col justify-between xl:col-span-5 bg-white dark:bg-[#0e1726] shadow-md rounded-xl p-4" id="error-summary">
            <div class="flex-1 flex flex-col">
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-3">
                    <div>
                        <div class="flex justify-between items-center mb-3">
                            <div class="flex items-center gap-2">
                                @*<span class="text-slate-900 dark:text-slate-100 text-base md:text-lg material-symbols-outlined">monitoring</span>*@
                                @Html.Icon("monitoring", "w-[18px] h-[18px] md:text-lg shrink-0")
                                <h2 class="font-sans font-semibold text-slate-900 dark:text-slate-100 text-sm md:text-base">
                                    Errors Summary
                                </h2>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 4 Subsystem Cards in a 2x2 Grid -->
                <div class="grid grid-cols-2 auto-rows-fr flex-1 gap-3 pt-1">
                    <!-- Item 1: Stored Procedure Failures -->
                    <div class="cursor-pointer bg-slate-100 dark:bg-[#142033] h-full p-3.5 rounded-md transition-all duration-200 hover:-translate-y-0.5 flex flex-col justify-between group"
                         id="error-summary-logs"
                         data-action="open-error-modal"
                         data-error-type="dba_errorlog">
                        <div class="flex-1">
                            <div class="flex items-center justify-between mb-2">
                                <div class="flex items-center gap-2">
                                    <span class="error-title font-sans font-semibold text-sm text-slate-900 dark:text-white transition-colors">Error Logs</span>
                                </div>
                            </div>
                            <div class="mt-2 flex items-center gap-2">
                                <span class="font-mono text-2xl font-bold tracking-tight text-slate-900 dark:text-white error-count">0</span>
                                <span class="font-mono text-xs text-rose-600 dark:text-rose-600 error-badge">
                                    <!-- Incident icon -->
                                </span>
                            </div>
                        </div>
                    </div>
                    <!-- Item 2: SQL Agent Jobs -->
                    <div class="cursor-pointer bg-slate-100 dark:bg-[#142033] h-full p-3.5 rounded-md transition-all duration-200 hover:-translate-y-0.5 flex flex-col justify-between group"
                         id="error-summary-jobs"
                         data-action="open-error-modal"
                         data-error-type="dba_job_errorlog">
                        <div class="flex-1">
                            <div class="flex items-center justify-between mb-2">
                                <div class="flex item-center gap-2">
                                    <span class="error-title font-sans font-semibold text-sm text-slate-900 dark:text-white transition-colors">
                                        Error Jobs
                                    </span>
                                </div>
                            </div>
                            <div class="mt-2 flex items-center gap-2">
                                <span class="font-mono text-2xl font-bold tracking-tight text-slate-900 dark:text-white error-count">0</span>
                                <span class="font-mono text-xs error-badge">
                                    <!-- Incident icon -->
                                </span>
                            </div>
                        </div>
                    </div>
                    <!-- Item 3: Lock & Deadlock -->
                    <div class="cursor-pointer bg-slate-100 dark:bg-[#142033] h-full p-3.5 rounded-md transition-all duration-200 hover:-translate-y-0.5 flex flex-col justify-between group"
                         id="error-summary-lock"
                         data-action="open-error-modal"
                         data-error-type="dba_dblock_log">
                        <div class="flex-1">
                            <div class="flex items-center justify-between mb-2">
                                <div class="flex items-center gap-2">
                                    <span class="error-title font-sans font-semibold text-sm text-slate-900 dark:text-white transition-colors">
                                        Database Lock
                                    </span>
                                </div>
                            </div>
                            <div class="mt-2 flex items-center gap-2">
                                <span class="font-mono text-2xl font-bold tracking-tight text-slate-900 dark:text-white error-count">0</span>
                                <span class="font-mono text-xs error-badge">
                                    <!-- Incident icon -->
                                </span>
                            </div>
                        </div>
                    </div>
                    <!-- Item 4: Backup & Compliance -->
                    <div class="cursor-pointer bg-slate-100 dark:bg-[#142033] h-full p-3.5 rounded-md transition-all duration-200 hover:-translate-y-0.5 flex flex-col justify-between group"
                         id="error-summary-backup"
                         data-action="open-error-modal"
                         data-error-type="dba_dbbackup_log">
                        <div class="flex-1">
                            <div class="flex items-center justify-between mb-2">
                                <div class="flex items-center gap-2">
                                    <span class="error-title font-sans font-semibold text-sm text-slate-900 dark:text-white transition-colors">
                                        Backup
                                    </span>
                                </div>
                            </div>
                            <div class="mt-2 flex items-center gap-2">
                                <span class="font-mono text-2xl font-bold tracking-tight text-slate-900 dark:text-white error-count">0</span>
                                <span class="font-mono text-xs error-badge">
                                    <!-- Incident icon -->
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- Col Right (7 cols): High-Row Tables -->
        <div class="flex flex-col justify-between xl:col-span-7 bg-white dark:bg-[#0e1726] shadow-md rounded-xl p-4">
            <div>
                <div class="flex justify-between items-center flex-wrap sm:flex-nowrap mb-3">
                    <div class="flex items-center gap-2">
                        @Html.Icon("table_rows", "w-[18px] h-[18px] text-slate-900 dark:text-slate-100 text-base md:text-lg shrink-0")
                        <h2 class="font-sans font-semibold text-slate-900 dark:text-slate-100 text-sm md:text-base">
                            High-Row Tables (&ge; 2.5M Rows)
                        </h2>
                    </div>
                    <span class="bg-slate-200 dark:bg-slate-500/20 shadow-sm px-2.5 py-1.5 rounded font-mono font-medium text-slate-600 dark:text-slate-400 text-xs" id="table-large-badge">LARGE TABLES</span>
                </div>
                <div class="rounded-lg overflow-hidden">
                    <!--bg-[#142033]-->
                    <div class="max-h-[25vh] overflow-y-auto snap-mandatory snap-y">
                        <table class="w-full font-mono text-xs text-left text-slate-800 dark:text-slate-200" id="table-large">
                            <thead class="top-0 z-10 sticky">
                                <tr class="bg-slate-100 dark:bg-[#0a1220] text-slate-600 dark:text-slate-400 text-xs uppercase">
                                    <th class="px-3 py-2.5">TABLE NAME</th>
                                    <th class="px-3 py-2.5">DATABASE</th>
                                    <th class="px-3 py-2.5">TOTAL ROWS</th>
                                    <th class="px-3 py-2.5">LEVEL</th>
                                    <th class="px-3 py-2.5 text-center">RESERVED</th>
                                </tr>
                            </thead>
                            <tbody class="text-xs divide-y divide-slate-200 dark:divide-[#142033]/40"></tbody>
                        </table>
                    </div>
                </div>
            </div>
            <div class="flex justify-between items-center bg-slate-100/60 dark:bg-[#0a1220]/60 -mx-4 mt-3 -mb-4 px-4 py-3 pt-3 rounded-b-xl font-mono text-slate-600 dark:text-slate-400 text-xs">
                <span class="px-2.5 py-0.5 rounded font-mono font-semibold text-cyan-700 dark:text-cyan-300 text-xs" id="total-tables-capacity">TOTAL CAPACITY (0 TABLES): 0 GB</span>
            </div>
        </div>
    </div>

    <!-- ROW 2: ALWAYS ON AG & HIGH-CAPACITY TABLE TELEMETRY -->
    <div class="gap-3 grid grid-cols-1 xl:grid-cols-12">
        <!-- Col Left (5 cols): SAN &amp; Local Storage Analysis -->
        <div class="flex flex-col justify-between xl:col-span-5 bg-white dark:bg-[#0e1726] shadow-md rounded-xl p-4">
            <div>
                <div class="flex justify-between items-center mb-3">
                    <div class="flex items-center gap-2">
                        @Html.Icon("hard_drive", "w-[18px] h-[18px] text-slate-900 dark:text-slate-100 text-base md:text-lg shrink-0")
                        <h2 class="font-sans font-semibold text-slate-900 dark:text-slate-100 text-sm md:text-base">
                            SAN &amp; Local Storage Analysis
                        </h2>
                    </div>
                </div>
                <div class="mb-3 space-y-2.5">
                    <!-- Nav Underline Tabs Bar -->
                    <div class="border-b border-slate-200 dark:border-slate-800/80">
                        <ul class="flex flex-row flex-nowrap overflow-x-auto text-xs font-mono gap-2 sm:gap-4 -mb-px"
                            id="san-server-tabs" role="tablist">
                        </ul>
                    </div>

                    <!-- Server Info Metadata Ribbon Bar -->
                    <div class="flex items-center justify-between px-3 py-1.5 bg-slate-50 dark:bg-[#0a1220]/80 rounded-lg text-xs font-mono border border-slate-200 dark:border-slate-800/60 shadow-inner"
                         id="storage-info-bar">
                        <div class="flex items-center gap-2 text-slate-700 dark:text-slate-300 truncate">
                            @Html.Icon("database", "w-[16px] h-[16px] text-cyan-600 dark:text-cyan-400 shrink-0")
                            <span class="text-slate-600 dark:text-slate-400">SERVER NAME:</span>
                            <span class="font-bold text-slate-900 dark:text-white" id="storage-active-server-name">
                                @* Server Name *@
                            </span>
                            <span class="text-cyan-700 dark:text-cyan-300" id="storage-active-server-ip">
                                @* Server IP *@
                            </span>
                            @*<span class="text-slate-500 hidden md:inline">•</span>*@
                            @*<span
                                    class="text-slate-600 dark:text-slate-400 hidden md:inline text-[11px]"
                                    id="storage-active-server-role"
                                    >Primary Node • Synchronized</span
                                >*@
                        </div>
                        <div class="flex items-center gap-2 shrink-0">
                            @*<span
                                    class="text-[10px] text-emerald-700 dark:text-emerald-400 bg-emerald-100 dark:bg-emerald-500/15 border border-emerald-200 dark:border-emerald-500/30 px-2 py-0.5 rounded font-bold"
                                    id="storage-active-server-status"
                                    >ONLINE</span
                                >*@
                            <span class="text-slate-600 dark:text-slate-400 text-[11px] hidden sm:inline"
                                  id="storage-active-server-multipath">SAN Disk: 0 Disks</span>
                        </div>
                    </div>
                </div>

                <!-- Disks Cards -->
                <div class="relative min-h-[190px]" id="storage-tab-panes"></div>
            </div>
        </div>
        <!-- Col Right (7 cols): Always On AG Health Status -->
        <div class="flex flex-col justify-between xl:col-span-7 bg-white dark:bg-[#0e1726] shadow-md rounded-xl p-4">
            <div>
                <div class="flex justify-between flex-wrap sm:flex-nowrap items-center mb-3">
                    <div class="flex items-center gap-2">
                        @Html.Icon("sync_alt", "w-[18px] h-[18px] text-slate-900 dark:text-slate-100 text-base md:text-lg shrink-0")
                        <h2 class="font-sans font-semibold text-slate-900 dark:text-slate-100 text-sm md:text-base">
                            Always On AG Health Status
                        </h2>
                    </div>
                    <span class="bg-slate-200 dark:bg-slate-500/20 shadow-sm px-2.5 py-1.5 rounded font-mono font-medium text-slate-600 dark:text-slate-400 text-xs" id="alwayson-badge">S</span>
                </div>
                <div class="bg-slate-50 dark:bg-[#0a1220]/70 rounded-lg overflow-hidden">
                    <div class="max-h-[25vh] overflow-y-auto snap-mandatory snap-y">
                        <table class="w-full font-mono text-xs text-left text-slate-800 dark:text-slate-200" id="table-alwayson">
                            <thead class="top-0 z-10 sticky bg-slate-100 dark:bg-[#09101c] text-[11px] text-slate-600 dark:text-slate-400 uppercase tracking-wider">
                                <tr>
                                    <th class="px-3 py-2.5 whitespace-nowrap">DATABASE</th>
                                    <th class="px-3 py-2.5 whitespace-nowrap">REPLICA SERVER</th>
                                    <th class="px-3 py-2.5 whitespace-nowrap">ROLE</th>
                                    <th class="px-3 py-2.5 whitespace-nowrap">CONN</th>
                                    <th class="px-3 py-2.5 whitespace-nowrap">SYNC STATE</th>
                                    <th class="px-3 py-2.5 whitespace-nowrap text-center">HEALTH</th>
                                    <th class="px-3 py-2.5 whitespace-nowrap text-right">LOG QUEUE</th>
                                    <th class="px-3 py-2.5 whitespace-nowrap text-right">REDO QUEUE</th>
                                    <th class="px-3 py-2.5 whitespace-nowrap text-right">LOG RATE</th>
                                    <th class="px-3 py-2.5 whitespace-nowrap text-right">REDO RATE</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-200 dark:divide-[#142033]/40 text-xs"></tbody>
                        </table>
                    </div>
                </div>
            </div>
            <div class="flex justify-between items-center bg-slate-100/60 dark:bg-[#0a1220]/60 -mx-4 mt-3 -mb-4 px-4 py-3 pt-3 rounded-b-xl font-mono text-slate-600 dark:text-slate-400 text-xs">
                <span class="shadow-sm px-2.5 py-0.5 rounded font-mono font-semibold text-emerald-700 dark:text-emerald-400 text-xs">AUTO FAILOVER: ENABLED</span>
                <!-- <span
                    class="bg-emerald-100 dark:bg-emerald-500/20 shadow-sm px-2.5 py-0.5 rounded font-mono font-semibold text-emerald-700 dark:text-emerald-400 text-xs"
                    >HEALTH CHECK TIMEOUT: 30000ms</span
                > -->
            </div>
        </div>
    </div>
</main>

<!-- Modal -->
<div class="fixed inset-0 bg-black/40 dark:bg-black/60 backdrop-blur-sm z-50 hidden flex items-center justify-center p-3 sm:p-5"
     id="error-modal">
    <div class="w-full max-w-[1500px] bg-white dark:bg-[#09101c] rounded-2xl shadow-2xl shadow-black border border-slate-200 dark:border-slate-800/80 flex flex-col max-h-[92vh] overflow-hidden">
        <!-- Modal Header with Subsystem Switcher Tabs -->
        <div class="p-4 bg-slate-100 dark:bg-[#0e1726] border-b border-slate-200 dark:border-slate-800 flex flex-col gap-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-3">
                    <div class="w-9 h-9 rounded-xl bg-cyan-100 dark:bg-cyan-500/20 text-cyan-700 dark:text-cyan-300 flex items-center justify-center border border-cyan-200 dark:border-cyan-500/30"
                         id="modal-subsystem-icon-wrap">
                        @Html.Icon("terminal", "w-[1.25rem] h-[1.25rem] text-xl shrink-0")
                    </div>
                    <div>
                        <div class="flex items-center gap-2">
                            <h3 class="font-sans font-bold text-base text-slate-900 dark:text-white" id="modal-subsystem-title">
                                Errors Details
                            </h3>
                        </div>
                        <p class="text-xs text-slate-600 dark:text-slate-400 mt-0.5" id="modal-subsystem-desc">
                            Select an incident to view technical root cause, remediation steps, and execute
                            handler dispatch
                        </p>
                    </div>
                </div>
                <button class="p-1.5 rounded-lg text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white hover:bg-slate-200 dark:hover:bg-[#152238] transition-colors"
                        data-action="close-error-modal">
                    @Html.Icon("close", "w-[1.25rem] h-[1.25rem] shrink-0")
                </button>
            </div>
            <!-- Navigation tabs between 4 subsystems within modal -->
            <div class="flex items-center gap-2 overflow-x-auto pb-1 text-xs font-mono" id="category-filter-bar">
            </div>
        </div>

        <!-- Filter Toolbar -->
        <div class="grid grid-cols-1 xl:grid-cols-12 gap-3">
            <!-- Severity Filters -->
            <div class="xl:col-span-6 flex flex-wrap items-center gap-1.5 py-1.5 px-3" id="severity-filter-bar">
                <!-- Dynamic category tabs rendered by JS -->
            </div>
            <!-- Controls: Search & Expand/Collapse -->
            <div class="xl:col-span-6 flex items-center justify-start xl:justify-end gap-1.5 py-1.5 px-3">
                <div class="flex flex-wrap items-center gap-2">
                    <div class="relative flex items-center">
                        @Html.Icon("search", "w-[16px] h-[16px] absolute left-2 text-slate-500 shrink-0")
                        <input class="bg-white dark:bg-slate-900 pl-8 pr-3 py-1.5 h-8 rounded text-[12px] text-slate-900 dark:text-slate-100 placeholder:text-slate-500 focus:outline-none focus:bg-slate-50 dark:focus:bg-slate-800 border border-slate-300 dark:border-slate-700 transition-colors w-64 md:w-72"
                               id="incident-search"
                               placeholder="Filter incidents, Incident ID, errors... (Ctrl+K)"
                               type="text" />
                    </div>
                    <button class="h-8 px-2.5 rounded bg-slate-100 dark:bg-slate-900 hover:bg-slate-200 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-200 font-medium text-[12px] flex items-center gap-1.5 border border-slate-300 dark:border-slate-700 transition-colors"
                            id="btn-expand-all"
                            data-action="expand-all"
                            type="button">
                        @Html.Icon("unfold_more", "w-[16px] h-[16px] text-blue-600 dark:text-blue-400 shrink-0")
                        <span>Expand All</span>
                    </button>
                    <button class="h-8 px-2.5 rounded bg-slate-100 dark:bg-slate-900 hover:bg-slate-200 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-200 font-medium text-[12px] flex items-center gap-1.5 border border-slate-300 dark:border-slate-700 transition-colors"
                            id="btn-collapse-all"
                            data-action="collapse-all"
                            type="button">
                        @Html.Icon("unfold_less", "w-[16px] h-[16px] text-blue-600 dark:text-blue-400 shrink-0")
                        <span>Collapse All</span>
                    </button>
                </div>
            </div>
        </div>

        <!-- 3-LEVEL HIERARCHICAL ACCORDION CONTAINER -->
        <div class="bg-white dark:bg-[#09101c] p-4 sm:p-5 overflow-y-auto space-y-3" id="accordion-root"></div>

        <!-- Modal Footer -->
        <div class="p-3 bg-slate-100 dark:bg-[#0a1220] border-t border-slate-200 dark:border-slate-800/80 flex items-center justify-end font-mono text-xs text-slate-600 dark:text-slate-400">
            <!-- <div class="flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                <span>TELEMETRY NOC ENGINE v4.2 • LEVEL 2 DRILL-DOWN READY</span>
            </div> -->
            <button class="px-5 py-3 rounded-lg bg-slate-200 dark:bg-[#142033] hover:bg-slate-300 dark:hover:bg-[#1c2e47] text-slate-700 dark:text-slate-200 hover:text-slate-900 dark:hover:text-white text-xs font-sans font-medium transition-colors uppercase"
                    data-action="close-error-modal">
                Close
            </button>
        </div>
    </div>
</div>


<!-- ==================== TOAST NOTIFICATION CONTAINER ==================== -->
<div class="right-5 bottom-5 z-50 fixed flex flex-col gap-2 pointer-events-none" id="toast-container"></div>

@section Scripts{
    <script>
        var currentUser = {
            employeeCode: '@CurrentUser.Info.EmployeeCode',
            employeeName: '@CurrentUser.Info.EmployeeName',
            email: '@CurrentUser.Info.Email'
        };
    </script>
    <script type="module" src="@Url.Content("~/Scripts/custom/objects/index.js")"></script>
}