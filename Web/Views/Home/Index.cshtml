                    </div>

                    <!-- Server Info Metadata Ribbon Bar -->
                    <!-- <div
                        class="flex items-center justify-between px-3 py-1.5 bg-[#0a1220]/80 rounded-lg text-xs font-mono border border-slate-800/60 shadow-inner"
