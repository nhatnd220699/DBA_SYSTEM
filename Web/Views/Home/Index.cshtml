                                        onclick="switchStorageServerTab('fatp02')"
                                        id="tab-btn-fatp02">
                                    <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
                                    <span class="font-mono font-medium tracking-tight">10.36.6.22</span>
                                </button>
                            </li>
                            <li role="presentation" class="shrink-0">
                                <button type="button"
                                        role="tab"
                                        aria-selected="false"
                                        class="storage-server-tab flex items-center gap-1.5 py-2 px-3 text-slate-400 border-b-2 border-transparent transition-all hover:text-slate-200 hover:border-slate-700 font-medium group"
                                        onclick="switchStorageServerTab('crapp')"
                                        id="tab-btn-crapp">
                                    <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
                                    <span class="font-mono font-medium tracking-tight">10.36.7.15</span>
                                </button>
                            </li>
                            <li role="presentation" class="shrink-0">
                                <button type="button"
                                        role="tab"
                                        aria-selected="false"
                                        class="storage-server-tab flex items-center gap-1.5 py-2 px-3 text-slate-400 border-b-2 border-transparent transition-all hover:text-slate-200 hover:border-slate-700 font-medium group"
                                        onclick="switchStorageServerTab('smt01')"
                                        id="tab-btn-smt01">
                                    <span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span>
                                    <span class="font-mono font-medium tracking-tight">10.36.8.40</span>
