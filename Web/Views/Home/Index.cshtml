                        </div>
                    </div> -->
                </div>

                <!-- Disks Cards -->
                <div class="relative min-h-[190px]" id="storage-tab-panes">
                    <div class="gap-3 grid grid-cols-2 md:grid-cols-4 storage-pane transition-opacity duration-300 opacity-100"
                         id="pane-fatp01">
                        <!-- Drive C -->
                        <!-- Ổ C: Windows System Drive -->
                        <div class="flex flex-col justify-between bg-[#121c2d] hover:bg-[#18263e] shadow-md p-3.5 rounded-xl transition-all duration-200">
                            <div class="flex flex-col items-center w-full text-center">
                                <!-- Windows Drive Visual SVG -->
                                <div class="relative mb-2.5 filter">
                                    <img src="@Url.Content("~/Content/images/hdd_48.png")" alt="disk" />
                                </div>
                                <!-- Drive Label & Role -->
                                <span class="font-mono font-bold text-white text-xs tracking-tight">Disk (C:)</span>
                                <!-- <span class="mt-0.5 max-w-full font-sans text-[11px] text-slate-400 truncate"
                                    >OS &amp; System Binaries</span
                                > -->
                            </div>

                            <!-- Capacity Metric & Progress Bar -->
                            <div class="space-y-1.5 mt-3 w-full">
                                <div class="font-mono text-base text-center">
                                    <span class="font-semibold text-slate-100">1.37</span>
                                    <span class="text-slate-400">/ 2.0 TB</span>
                                </div>
                                <div class="pt-1 text-center">
                                    <span class="inline-block font-mono font-medium text-[12px] text-slate-100 tracking-wide">31.6% Free (630 GB)</span>
                                </div>
                            </div>
                        </div>

                        <!-- Ổ D: Data LUN 01 (Warning) -->
                        <div class="flex flex-col justify-between bg-[#121c2d] hover:bg-[#18263e] shadow-md p-3.5 rounded-xl transition-all duration-200">
                            <div class="flex flex-col items-center w-full text-center">
                                <!-- Data Drive Visual SVG -->
                                <div class="relative mb-2.5 filter">
                                    <img src="@Url.Content("~/Content/images/hdd_48.png")" alt="disk" />
                                </div>
                                <span class="font-mono font-bold text-white text-xs tracking-tight">Disk (D:)</span>
                                <!-- <span class="mt-0.5 max-w-full font-sans text-[11px] text-slate-400 truncate"
                                    >MDF User Tablespace</span
                                > -->
                            </div>

                            <div class="space-y-1.5 mt-3 w-full">
                                <div class="font-mono text-base text-center">
                                    <span class="font-semibold text-slate-100">8.80</span>
                                    <span class="text-slate-400">/ 10.0 TB</span>
                                </div>
                                <div class="pt-1 text-center">
                                    <span class="inline-block font-mono font-medium text-[12px] text-slate-100 tracking-wide">12.0% Free (Warn)</span>
                                </div>
                            </div>
                        </div>

                        <!-- Ổ L: Active Log (Critical Alert) -->
                        <div class="flex flex-col justify-between bg-[#121c2d] hover:bg-[#18263e] shadow-md p-3.5 rounded-xl transition-all duration-200">
                            <div class="flex flex-col items-center w-full text-center">
                                <!-- Log Drive Visual SVG -->
                                <div class="relative mb-2.5 filter">
                                    <img src="@Url.Content("~/Content/images/hdd_48.png")" alt="disk" />
                                </div>
                                <span class="font-mono font-bold text-white text-xs tracking-tight">Disk (L:)</span>
                                <!-- <span
                                    class="mt-0.5 max-w-full font-sans font-medium text-[11px] text-rose-400/90 truncate"
                                    >LDF Write Buffer (Full)</span
                                > -->
