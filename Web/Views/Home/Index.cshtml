@{
    ViewBag.Title = "DBA Analysis";
}

<!-- ==================== MAIN DASHBOARD LAYOUT ==================== -->
<main class="space-y-3 bg-[#252d3d] px-4 py-4 w-full">
    <!--#040810-->
    <!-- TOP KPI CARDS -->
    <div class="gap-3 grid grid-cols-2 lg:grid-cols-4">
        <!-- KPI 1: INSTANCES -->
        <!-- <div class="flex justify-between items-center gap-3 bg-[#0e1726]  rounded-xl shadow-xl px-4 py-8">
            <div class="flex-1 min-w-0">
                <div class="flex justify-between items-center gap-1 mb-1">
                    <span class="font-mono font-semibold text-slate-400 text-xs uppercase tracking-wider"
                        >TOTAL ERRORS</span
                    >

                </div>
                <div class="font-mono font-bold text-slate-100 text-xl md:text-2xl tracking-tight">
                    56
                </div>
            </div>
            <div
                class="flex justify-center items-center bg-[#16233b] md:round-md rounded-xl w-9 md:w-12 h-9 md:h-12 text-slate-400 shrink-0"
            >
                <span class="text-2xl material-symbols-outlined">dns</span>
            </div>
        </div> -->
        <!-- KPI 2: OPEN INCIDENTS -->
        <div class="flex justify-between items-center gap-3 bg-[#0e1726] rounded-xl shadow-xl px-4 py-8">
            <div class="flex-1 min-w-0">
                <div class="flex justify-between items-center gap-1 mb-1">
                    <span class="font-mono font-semibold text-slate-400 text-xs uppercase tracking-wider">CRITIAL/HIGH</span>
                    <!-- <span
                        class="bg-rose-500/20 px-1.5 py-0.5 rounded font-mono font-semibold text-rose-400 text-xs"
                        >2 CRIT</span
                    > -->
                </div>
                <div class="font-mono font-bold text-rose-600 text-xl md:text-3xl tracking-tight">
                    12
                    <!-- <span class="ml-1 font-mono font-medium text-amber-400 text-xs">5 High</span> -->
                </div>
            </div>
            <div class="flex justify-center items-center bg-[#16233b] rounded-xl w-9 md:w-12 h-9 md:h-12 text-slate-400 shrink-0">
                @*<span class="text-2xl material-symbols-outlined">warning</span>*@
                @Html.Icon("warning", "w-[24px] h-[24px] shrink-0")
            </div>
        </div>

        <!-- KPI 3: MTTR -->
        <div class="flex justify-between items-center gap-3 bg-[#0e1726] rounded-xl shadow-xl px-4 py-8">
            <div class="flex-1 min-w-0">
                <div class="flex justify-between items-center gap-1 mb-1">
                    <span class="font-mono font-semibold text-slate-400 text-xs uppercase tracking-wider">Medium</span>
                    <!-- <span
                        class="bg-cyan-500/20 px-1.5 py-0.5 rounded font-mono font-semibold text-cyan-300 text-xs"
                        >-3.8m</span
                    > -->
                </div>
                <div class="font-mono font-bold text-slate-100 text-xl md:text-3xl tracking-tight">
                    10
                    <!-- <span class="font-mono font-normal text-slate-400 text-xs">Min</span> -->
                </div>
            </div>
            <div class="flex justify-center items-center bg-[#16233b] rounded-xl w-9 md:w-12 h-9 md:h-12 text-slate-400 shrink-0">
                @*<span class="text-2xl material-symbols-outlined">report</span>*@
                @Html.Icon("report", "w-[24px] h-[24px] shrink-0")
            </div>
        </div>

        <!-- KPI 4: CAPACITY -->
        <div class="flex justify-between items-center gap-3 bg-[#0e1726] rounded-xl shadow-xl px-4 py-8">
            <div class="flex-1 min-w-0">
                <div class="flex justify-between items-center gap-1 mb-1">
                    <span class="font-mono font-semibold text-slate-400 text-xs uppercase tracking-wider">CAPACITY</span>
                    <!-- <span
                        class="bg-amber-500/20 px-1.5 py-0.5 rounded font-mono font-semibold text-amber-400 text-xs"
                        >78% USED</span
                    > -->
                </div>
                <div class="font-mono font-bold text-slate-100 text-xl md:text-3xl tracking-tight">0</div>
            </div>
            <div class="flex justify-center items-center bg-[#16233b] rounded-xl w-9 md:w-12 h-9 md:h-12 text-slate-400 shrink-0">
                @*<span class="text-2xl material-symbols-outlined">hard_drive</span>*@
                @Html.Icon("hard_drive", "w-[24px] h-[24px] shrink-0")
            </div>
        </div>

        <!-- KPI 5: BACKUP -->
        <div class="flex justify-between items-center gap-3 bg-[#0e1726] rounded-xl shadow-xl p-5 lg:px-4 lg:py-8">
            <div class="flex-1 min-w-0">
                <div class="flex justify-between items-center gap-1 mb-1">
                    <span class="font-mono font-semibold text-slate-400 text-xs uppercase tracking-wider">BACKUP</span>
                </div>
                <div class="font-mono font-bold text-slate-100 text-xl md:text-3xl tracking-tight">
                    100%
                    <!-- <span class="ml-1 font-mono font-semibold text-rose-400 text-xs">1 SMT Lag</span> -->
                </div>
            </div>
            <div class="flex justify-center items-center bg-[#16233b] rounded-xl w-9 md:w-12 h-9 md:h-12 text-slate-400 shrink-0">
                @*<span class="text-2xl material-symbols-outlined">cloud_done</span>*@
                @Html.Icon("cloud_done", "w-[24px] h-[24px] shrink-0")

            </div>
        </div>
    </div>

    <!-- ROW 1: INCIDENT DISTRIBUTION & DISK CAPACITY -->
    <div class="gap-3 grid grid-cols-1 xl:grid-cols-12">
        <!-- Col Left (5 cols): Errors Summary -->
        <div class="flex flex-col justify-between xl:col-span-5 bg-[#0e1726] shadow-md rounded-xl p-4">
            <div>
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-3">
                    <div>
                        <div class="flex justify-between items-center mb-3">
                            <div class="flex items-center gap-2">
                                <span class="text-slate-100 text-base md:text-lg material-symbols-outlined">monitoring</span>
                                <h2 class="font-sans font-semibold text-slate-100 text-sm md:text-base">
                                    Errors Summary
                                </h2>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- 4 Subsystem Cards in a 2x2 Grid -->
                <div class="grid grid-cols-1 grid-cols-2 md:grid-cols-4 gap-3 pt-1">
                    <!-- Item 1: Stored Procedure Failures -->
                    <div class="cursor-pointer bg-[#142033] p-3.5 rounded-md transition-all duration-200 hover:-translate-y-0.5 flex flex-col justify-between group"
                         onclick="openSubsystemModal('error-logs')">
                        <div>
                            <div class="flex items-center justify-between mb-2">
                                <div class="flex items-center gap-2">
                                    <span class="font-sans font-semibold text-sm text-white group-hover:text-rose-400 transition-colors">Error Logs</span>
                                </div>
                            </div>
                            <div class="mt-2 flex items-center gap-2">
                                <span class="font-mono text-2xl font-bold text-rose-600 tracking-tight">50</span>
                                <span class="font-mono text-xs text-rose-600">
                                    @*<span class="material-symbols-outlined font-bold animate-[pulse_2s_ease-in-out_infinite]">error</span>*@
                                    @Html.Icon("error", "w-[26px] h-[26px] font-bold animate-[pulse_2s_ease-in-out_infinite] shrink-0")

                                </span>
                            </div>
                        </div>
                    </div>
                    <!-- Item 2: SQL Agent Jobs -->
                    <div class="cursor-pointer bg-[#142033] p-3.5 rounded-md transition-all duration-200 hover:-translate-y-0.5 flex flex-col justify-between group"
                         onclick="openSubsystemModal('error-jobs')">
                        <div>
                            <div class="flex items-center justify-between mb-2">
                                <div class="flex item-center gap-2">
                                    <span class="font-sans font-semibold text-sm text-white group-hover:text-rose-400 transition-colors">
                                        Error Jobs
                                    </span>
                                </div>
                            </div>
                            <div class="mt-2 flex items-center gap-2">
                                <span class="font-mono text-2xl font-bold text-rose-600 tracking-tight">21</span>
                                <span class="font-mono text-xs text-rose-600">
                                    @Html.Icon("error", "w-[26px] h-[26px] font-bold animate-[pulse_2s_ease-in-out_infinite] shrink-0")

                                </span>
                            </div>
                        </div>
                    </div>
                    <!-- Item 3: Lock & Deadlock -->
                    <div class="cursor-pointer bg-[#142033] p-3.5 rounded-md transition-all duration-200 hover:-translate-y-0.5 flex flex-col justify-between group"
                         onclick="openSubsystemModal('database-lock')">
                        <div>
                            <div class="flex items-center justify-between mb-2">
                                <div class="flex items-center gap-2">
                                    <span class="font-sans font-semibold text-sm text-white group-hover:text-rose-400 transition-colors">
                                        Database Lock
                                    </span>
                                </div>
                            </div>
                            <div class="mt-2 flex items-center gap-2">
                                <span class="font-mono text-2xl font-bold text-rose-600 tracking-tight">40</span>
                                <span class="font-mono text-xs text-rose-600">
                                    @Html.Icon("error", "w-[26px] h-[26px] font-bold animate-[pulse_2s_ease-in-out_infinite] shrink-0")

                                </span>
                            </div>
                        </div>
                    </div>
                    <!-- Item 4: Backup & Compliance -->
                    <div class="cursor-pointer bg-[#142033] p-3.5 rounded-md transition-all duration-200 hover:-translate-y-0.5 flex flex-col justify-between group"
                         onclick="openSubsystemModal('backup')">
                        <div>
                            <div class="flex items-center justify-between mb-2">
                                <div class="flex items-center gap-2">
                                    <span class="font-sans font-semibold text-sm text-white group-hover:text-emerald-400 transition-colors">
                                        Backup
                                    </span>
                                </div>
                            </div>
                            <div class="mt-2 flex items-center gap-2">
                                <span class="font-mono text-2xl font-bold text-emerald-600 tracking-tight">0</span>
                                <span class="font-mono text-xs text-emerald-300/80">Errors</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- Col Right (7 cols): High-Row Tables -->
        <div class="flex flex-col justify-between xl:col-span-7 bg-[#0e1726] shadow-md rounded-xl p-4">
            <div>
                <div class="flex justify-between items-center flex-wrap sm:flex-nowrap mb-3">
                    <div class="flex items-center gap-2">
                        @*<span class="text-slate-100 text-base md:text-lg material-symbols-outlined">table_rows</span>*@
                        @Html.Icon("table_rows", "w-[18px] h-[18px] text-slate-100 text-base md:text-lg shrink-0")
                        <h2 class="font-sans font-semibold text-slate-100 text-sm md:text-base">
                            High-Row Tables (&ge; 2.5M Rows)
                        </h2>
                    </div>
                    <span class="bg-slate-500/20 shadow-sm px-2.5 py-1.5 rounded font-mono font-medium text-slate-400 text-xs" id="table-large-badge">LARGE TABLES</span>
                </div>
                <div class="rounded-lg overflow-hidden">
                    <!--bg-[#142033]-->
                    <div class="max-h-[240px] overflow-y-auto snap-mandatory snap-y">
                        <table class="w-full font-mono text-xs text-left" id="table-large">
                            <thead class="top-0 z-10 sticky">
                                <tr class="bg-[#0a1220] text-slate-400 text-xs uppercase">
                                    <th class="px-3 py-2.5">TABLE NAME</th>
                                    <th class="px-3 py-2.5">DATABASE</th>
                                    <th class="px-3 py-2.5 text-right">TOTAL ROWS</th>
                                    <th class="px-3 py-2.5 text-right">LEVEL</th>
                                    <th class="px-3 py-2.5 text-right">RESERVED</th>
                                </tr>
                            </thead>
                            <tbody class="text-xs"></tbody>
                        </table>
                    </div>
                </div>
            </div>
            <div class="flex justify-between items-center bg-[#0a1220]/60 -mx-4 mt-3 -mb-4 px-4 py-3 pt-3 rounded-b-xl font-mono text-slate-400 text-xs">
                <span class="px-2.5 py-0.5 rounded font-mono font-semibold text-cyan-300 text-xs">TOTAL CAPACITY (5 TABLES): 17.4 GB</span>
            </div>
        </div>
    </div>

    <!-- ROW 2: ALWAYS ON AG & HIGH-CAPACITY TABLE TELEMETRY -->
    <div class="gap-3 grid grid-cols-1 xl:grid-cols-12">
        <!-- Col Left (5 cols): SAN &amp; Local Storage Analysis -->
        <div class="flex flex-col justify-between xl:col-span-5 bg-[#0e1726] shadow-md rounded-xl p-4">
            <div>
                <div class="flex justify-between items-center mb-3">
                    <div class="flex items-center gap-2">
                        @Html.Icon("hard_drive", "w-[18px] h-[18px] text-slate-100 text-base md:text-lg shrink-0")
                        <h2 class="font-sans font-semibold text-slate-100 text-sm md:text-base">
                            SAN &amp; Local Storage Analysis
                        </h2>
                    </div>
                    <!-- <span
                        class="bg-emerald-500/20 shadow-sm px-2.5 py-0.5 rounded font-mono font-semibold text-emerald-400 text-xs"
