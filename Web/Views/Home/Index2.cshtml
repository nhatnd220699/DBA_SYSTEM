@{
    Layout = "layout";
    ViewBag.Title = "DBA Analysis";
}

<main class="w-full pt-20 bg-surface min-h-screen px-gutter">
    <div class="flex flex-col w-full gap-space-md">
        <!-- SECTION 1: OPERATIONAL ZONE SELECTOR & NOC ACTION BAR -->
        <div class="w-full bg-surface-container-low rounded-xl p-space-md shadow-md flex flex-wrap items-center justify-between gap-space-md">
            <!-- Zone Nav Pills -->
            <div class="flex items-center gap-space-xs overflow-x-auto py-0.5">
                <button class="zone-pill active-pill flex items-center gap-2 px-3 py-1.5 rounded-lg bg-primary-container text-on-primary-container transition-all"
                        id="zone-pill-ALL"
                        onclick="filterZone('ALL')"
                        type="button">
                    <span class="material-symbols-outlined text-[18px]">domain</span>
                    <span class="font-label-md text-label-md font-semibold">Tất cả khu vực (All Sites)</span>
                    <span class="font-label-caps text-label-caps bg-surface-container-lowest/80 text-on-surface px-1.5 py-0.5 rounded">48 DBs</span>
                </button>
                <button class="zone-pill flex items-center gap-2 px-3 py-1.5 rounded-lg bg-surface-container-high text-on-surface-variant hover:text-on-surface transition-all"
                        id="zone-pill-FATP"
                        onclick="filterZone('FATP')"
                        type="button">
                    @Html.Icon("precision_manufacturing", "w-[18px] h-[18px] shrink-0")
                    @*<span class="material-symbols-outlined text-[18px]">precision_manufacturing</span>*@
                    <span class="font-label-md text-label-md font-semibold">FATP (Assembly)</span>
                    <div class="flex items-center gap-1 font-label-caps text-label-caps">
                        <span class="bg-error-container text-on-error-container px-1 py-0.2 rounded font-semibold">1 Crit</span>
                        <span class="bg-surface-variant text-tertiary px-1 py-0.2 rounded font-semibold">3 Warn</span>
                    </div>
                </button>
                <button class="zone-pill flex items-center gap-2 px-3 py-1.5 rounded-lg bg-surface-container-high text-on-surface-variant hover:text-on-surface transition-all"
                        id="zone-pill-CR"
                        onclick="filterZone('CR')"
                        type="button">
                    @*<span class="material-symbols-outlined text-[18px]">clean_hands</span>*@
                    @Html.Icon("clean_hands", "w-[18px] h-[18px] shrink-0")
                    <span class="font-label-md text-label-md font-semibold">CR (Clean Room)</span>
                    <div class="flex items-center gap-1 font-label-caps text-label-caps">
                        <span class="bg-surface-variant text-secondary px-1 py-0.2 rounded font-semibold">0 Crit</span>
                        <span class="bg-surface-variant text-tertiary px-1 py-0.2 rounded font-semibold">1 Warn</span>
                    </div>
                </button>
                <button class="zone-pill flex items-center gap-2 px-3 py-1.5 rounded-lg bg-surface-container-high text-on-surface-variant hover:text-on-surface transition-all"
                        id="zone-pill-SMT"
                        onclick="filterZone('SMT')"
                        type="button">
                    @*<span class="material-symbols-outlined text-[18px]">memory</span>*@
                    @Html.Icon("memory", "w-[18px] h-[18px] shrink-0")
                    <span class="font-label-md text-label-md font-semibold">SMT (High-Tech)</span>
                    <div class="flex items-center gap-1 font-label-caps text-label-caps">
                        <span class="bg-error-container text-on-error-container px-1 py-0.2 rounded animate-pulse font-semibold">2 Crit</span>
                        <span class="bg-surface-variant text-tertiary px-1 py-0.2 rounded font-semibold">4 Warn</span>
                    </div>
                </button>
            </div>
            <!-- Quick Utilities: Range, Refresh, Comparison & Wallboard View -->
            <div class="flex items-center gap-space-sm flex-wrap">
                <div class="flex items-center bg-surface-container rounded-lg p-0.5">
                    <button class="px-2 py-1 text-on-surface font-label-caps text-label-caps rounded bg-surface-container-high"
                            type="button">
                        1H
                    </button>
                    <button class="px-2 py-1 text-on-surface-variant hover:text-on-surface font-label-caps text-label-caps"
                            type="button">
                        6H
                    </button>
                    <button class="px-2 py-1 text-on-surface-variant hover:text-on-surface font-label-caps text-label-caps"
                            type="button">
                        24H
                    </button>
                    <button class="px-2 py-1 text-on-surface-variant hover:text-on-surface font-label-caps text-label-caps"
                            type="button">
                        7D
                    </button>
                </div>
                <div class="flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-surface-container font-code-sm text-code-sm text-secondary">
                    @*<span class="material-symbols-outlined text-[16px] animate-spin text-secondary">autorenew</span>*@
                    @Html.Icon("autorenew", "w-[20px] h-[20px] shrink-0 animate-spin")
                    <span class="hidden sm:inline">Làm mới:</span>
                    <span class="font-semibold text-secondary-fixed">10s (Auto)</span>
                </div>
                <button class="flex items-center gap-1 px-3 py-1 rounded-lg bg-surface-container-high hover:bg-surface-variant text-on-surface font-label-md text-label-md transition-all shadow-sm"
                        onclick="openCompareModal()"
                        type="button">
                    <span class="material-symbols-outlined text-[16px] text-primary">balance</span>
                    <span class="hidden md:inline">So sánh 3 khu vực</span>
                </button>
                <button class="flex items-center gap-1 px-3 py-1 rounded-lg bg-primary hover:bg-primary-fixed-dim text-on-primary font-label-md text-label-md transition-all shadow-sm"
                        onclick="toggleWallboardMode()"
                        type="button">
                    <span class="material-symbols-outlined text-[16px]">tv</span>
                    <span class="hidden md:inline">Wallboard NOC TV</span>
                </button>
            </div>
        </div>
        <!-- SECTION 2: 5 KPI CARDS (SLA TELEMETRY STANDARDS) -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-gutter">
            <!-- Card 1: Total Instances -->
            <div class="bg-surface-container rounded-xl p-space-md shadow-md flex flex-col justify-between relative overflow-hidden group">
                <div class="flex items-center justify-between">
                    <span class="font-label-caps text-label-caps text-outline uppercase tracking-wider">Tổng SQL Server</span>
                    <span class="material-symbols-outlined text-[20px] text-primary">database</span>
                </div>
                <div class="mt-2 flex items-baseline justify-between">
                    <span class="font-metric-xl text-metric-xl text-on-surface font-bold">48</span>
                    <span class="font-label-caps text-label-caps text-primary bg-primary/10 px-1.5 py-0.5 rounded">FLEET PROD</span>
                </div>
                <div class="mt-2 flex items-center justify-between font-code-sm text-code-sm text-on-surface-variant pt-2 border-t-0 bg-surface-container-low/50 px-2 py-1 rounded">
                    <span class="flex items-center gap-1 text-secondary"><span class="h-1.5 w-1.5 rounded-full bg-secondary"></span>46 Online</span>
                    <span class="flex items-center gap-1 text-tertiary"><span class="h-1.5 w-1.5 rounded-full bg-tertiary"></span>2 Degr</span>
                    <span class="flex items-center gap-1 text-outline">0 Off</span>
                </div>
            </div>
            <!-- Card 2: Healthy Instances -->
            <div class="bg-surface-container rounded-xl p-space-md shadow-md flex flex-col justify-between relative overflow-hidden">
                <div class="flex items-center justify-between">
                    <span class="font-label-caps text-label-caps text-outline uppercase tracking-wider">Trạng thái Healthy</span>
                    <div class="relative flex h-2.5 w-2.5">
                        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-secondary opacity-75"></span>
                        <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-secondary"></span>
                    </div>
                </div>
                <div class="mt-2 flex items-baseline justify-between">
                    <span class="font-metric-xl text-metric-xl text-secondary font-bold">85.4%</span>
                    <span class="font-code-sm text-code-sm text-on-surface">41/48 Hosts</span>
                </div>
                <div class="mt-2 flex items-center gap-1 text-secondary font-code-sm text-code-sm pt-2 bg-secondary/5 px-2 py-1 rounded">
                    <span class="material-symbols-outlined text-[16px]">monitor_heart</span>
                    <span class="">SLA Cam kết: &gt; 99.95%</span>
                </div>
            </div>
            <!-- Card 3: Warning Alerts -->
            <div class="bg-surface-container rounded-xl p-space-md shadow-md flex flex-col justify-between relative overflow-hidden">
                <div class="flex items-center justify-between">
                    <span class="font-label-caps text-label-caps text-outline uppercase tracking-wider">Cảnh báo Warning</span>
                    <span class="material-symbols-outlined text-[20px] text-tertiary">warning</span>
                </div>
                <div class="mt-2 flex items-baseline justify-between">
                    <span class="font-metric-xl text-metric-xl text-tertiary font-bold">08</span>
                    <span class="font-label-caps text-label-caps bg-tertiary/15 text-tertiary px-1.5 py-0.5 rounded font-semibold">Tier-2 Alert</span>
                </div>
                <div class="mt-2 flex items-center justify-between text-on-surface-variant font-code-sm text-code-sm pt-2 bg-surface-container-low/50 px-2 py-1 rounded">
                    <span class="truncate">CPU &gt; 85% • Delay Diff BKP</span>
                    <span class="text-tertiary font-semibold">+2 mới</span>
                </div>
            </div>
            <!-- Card 4: Critical Incidents -->
            <div class="bg-surface-container rounded-xl p-space-md shadow-md flex flex-col justify-between relative overflow-hidden">
                <div class="flex items-center justify-between">
                    <span class="font-label-caps text-label-caps text-outline uppercase tracking-wider">Sự cố Critical</span>
                    <span class="material-symbols-outlined text-[20px] text-error animate-bounce">report</span>
                </div>
                <div class="mt-2 flex items-baseline justify-between">
                    <span class="font-metric-xl text-metric-xl text-error font-bold">03</span>
                    <span class="font-label-caps text-label-caps bg-error-container text-on-error-container px-1.5 py-0.5 rounded font-bold animate-pulse">ACTION REQ</span>
                </div>
                <div class="mt-2 flex items-center justify-between font-code-sm text-code-sm text-error pt-2 bg-error-container/20 px-2 py-1 rounded">
                    <span class="truncate">SMT Chain Lock • LUN 96%</span>
                    <span class="font-bold">P1</span>
                </div>
            </div>
            <!-- Card 5: MTTR & 24h Alerts -->
            <div class="bg-surface-container rounded-xl p-space-md shadow-md flex flex-col justify-between relative overflow-hidden">
                <div class="flex items-center justify-between">
                    <span class="font-label-caps text-label-caps text-outline uppercase tracking-wider">Alerts 24h &amp; MTTR</span>
                    <span class="material-symbols-outlined text-[20px] text-primary">timer</span>
                </div>
                <div class="mt-2 flex items-baseline justify-between">
                    <span class="font-metric-xl text-metric-xl text-on-surface font-bold">142</span>
                    <span class="font-code-sm text-code-sm text-secondary font-semibold">131 Đã xong</span>
                </div>
                <div class="mt-2 flex items-center justify-between font-code-sm text-code-sm pt-2 bg-surface-container-low/50 px-2 py-1 rounded">
                    <span class="text-on-surface-variant">MTTR trung bình:</span>
                    <span class="font-metric-md text-metric-md text-primary font-bold">8.4 ph</span>
                </div>
            </div>
        </div>
        <!-- ROW 1: ALERT DISTRIBUTION & REALTIME RESOURCE GAUGES -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-gutter">
            <!-- Col-lg-5: Alert Distribution & Site Percentages -->
            <div class="lg:col-span-5 bg-surface-container rounded-xl p-space-md shadow-md flex flex-col justify-between">
                <div class="flex items-center justify-between mb-space-sm">
                    <div class="flex items-center gap-2">
                        <span class="material-symbols-outlined text-primary text-[18px]">pie_chart</span>
                        <h2 class="font-headline-sm text-headline-sm text-on-surface font-semibold">
                            Phân bổ Cảnh báo theo Trạng thái &amp; Khu vực
                        </h2>
                    </div>
                    <span class="font-label-caps text-label-caps bg-surface-container-high px-2 py-0.5 rounded text-outline font-semibold">TELEMETRY RING</span>
                </div>
                <div class="grid grid-cols-1 sm:grid-cols-12 gap-space-md items-center my-auto">
                    <!-- SVG Ring Chart -->
                    <div class="sm:col-span-6 flex flex-col items-center justify-center relative">
                        <svg class="w-36 h-36 transform -rotate-90" viewbox="0 0 36 36">
                            <!-- Background circle -->
                            <path class="text-surface-container-highest"
                                  d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831"
                                  fill="none"
                                  stroke="currentColor"
                                  stroke-width="3.5"></path>
                            <!-- Healthy 82% (Stroke array 82 100) -->
                            <path class="text-secondary"
                                  d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831"
                                  fill="none"
                                  stroke="currentColor"
                                  stroke-dasharray="82, 100"
                                  stroke-linecap="round"
                                  stroke-width="3.8"></path>
                            <!-- Warning 12% (dasharray 12, 100, offset -82) -->
                            <path class="text-tertiary"
                                  d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831"
                                  fill="none"
                                  stroke="currentColor"
                                  stroke-dasharray="12, 100"
                                  stroke-dashoffset="-82"
                                  stroke-linecap="round"
                                  stroke-width="3.8"></path>
                            <!-- Critical 6% (dasharray 6, 100, offset -94) -->
                            <path class="text-error"
                                  d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831"
                                  fill="none"
                                  stroke="currentColor"
                                  stroke-dasharray="6, 100"
                                  stroke-dashoffset="-94"
                                  stroke-linecap="round"
                                  stroke-width="3.8"></path>
                        </svg>
                        <div class="absolute inset-0 flex flex-col items-center justify-center pointer-events-none">
                            <span class="font-display-lg text-[22px] font-bold text-on-surface">82%</span>
                            <span class="font-label-caps text-[9px] text-secondary uppercase font-semibold">HEALTHY</span>
                        </div>
                    </div>
                    <!-- Legend & Breakdown -->
                    <div class="sm:col-span-6 flex flex-col gap-2 font-code-sm text-code-sm">
                        <div class="p-2 rounded bg-surface-container-low flex items-center justify-between">
                            <div class="flex items-center gap-1.5">
                                <span class="h-2 w-2 rounded-full bg-secondary"></span>
                                <span class="text-on-surface">Healthy</span>
                            </div>
                            <span class="font-bold text-secondary">82% (41 Nodes)</span>
                        </div>
                        <div class="p-2 rounded bg-surface-container-low flex items-center justify-between">
                            <div class="flex items-center gap-1.5">
                                <span class="h-2 w-2 rounded-full bg-tertiary"></span>
                                <span class="text-on-surface">Warning</span>
                            </div>
                            <span class="font-bold text-tertiary">12% (5 Nodes)</span>
                        </div>
                        <div class="p-2 rounded bg-surface-container-low flex items-center justify-between">
                            <div class="flex items-center gap-1.5">
                                <span class="h-2 w-2 rounded-full bg-error"></span>
                                <span class="text-on-surface">Critical</span>
                            </div>
                            <span class="font-bold text-error">6% (2 Nodes)</span>
                        </div>
                    </div>
                </div>
                <!-- Site Tỷ lệ cảnh báo -->
                <div class="mt-space-sm pt-2 bg-surface-container-low rounded-lg p-2.5">
                    <span class="font-label-caps text-label-caps text-outline block mb-1.5 uppercase font-semibold">Tỷ lệ tải trọng lỗi theo 3 Phân khu:</span>
                    <div class="flex items-center gap-2">
                        <div class="flex-1">
                            <div class="flex justify-between font-label-caps text-label-caps mb-0.5">
                                <span class="text-on-surface">SMT Floor</span>
                                <span class="text-tertiary font-bold">45%</span>
                            </div>
                            <div class="w-full bg-surface-container-highest h-1.5 rounded-full overflow-hidden">
                                <div class="bg-tertiary h-full rounded-full w-[45%]"></div>
                            </div>
                        </div>
                        <div class="flex-1">
                            <div class="flex justify-between font-label-caps text-label-caps mb-0.5">
                                <span class="text-on-surface">FATP Plant</span>
                                <span class="text-primary font-bold">38%</span>
                            </div>
                            <div class="w-full bg-surface-container-highest h-1.5 rounded-full overflow-hidden">
                                <div class="bg-primary h-full rounded-full w-[38%]"></div>
                            </div>
                        </div>
                        <div class="flex-1">
                            <div class="flex justify-between font-label-caps text-label-caps mb-0.5">
                                <span class="text-on-surface">Clean Room</span>
                                <span class="text-secondary font-bold">17%</span>
                            </div>
                            <div class="w-full bg-surface-container-highest h-1.5 rounded-full overflow-hidden">
                                <div class="bg-secondary h-full rounded-full w-[17%]"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <!-- Col-lg-7: Real-time Resource Gauges & Load Comparison -->
            <div class="lg:col-span-7 bg-surface-container rounded-xl p-space-md shadow-md flex flex-col justify-between">
                <div class="flex items-center justify-between mb-space-sm">
                    <div class="flex items-center gap-2">
                        <span class="material-symbols-outlined text-secondary text-[18px]">speed</span>
                        <h2 class="font-headline-sm text-headline-sm text-on-surface font-semibold">
                            Đồng hồ &amp; Thước đo Tài nguyên Real-time
                        </h2>
                    </div>
                    <div class="flex items-center gap-2">
                        <span class="font-code-sm text-code-sm text-on-surface-variant">Host Spike:</span>
                        <span class="font-code-sm text-code-sm bg-error-container text-on-error-container px-1.5 py-0.5 rounded font-bold">SMT-SQL01 (94%)</span>
                    </div>
                </div>
                <!-- 4 Resource Indicators -->
                <div class="grid grid-cols-2 sm:grid-cols-4 gap-space-sm">
                    <!-- CPU Gauge -->
                    <div class="bg-surface-container-low p-space-sm rounded-lg flex flex-col items-center text-center">
                        <span class="font-label-caps text-label-caps text-outline uppercase font-semibold">CPU Fleet Avg</span>
                        <div class="my-2 relative w-20 h-20 flex items-center justify-center">
                            <svg class="w-full h-full transform -rotate-90" viewbox="0 0 36 36">
                                <circle class="text-surface-container-highest"
                                        cx="18"
                                        cy="18"
                                        fill="none"
                                        r="14"
                                        stroke="currentColor"
                                        stroke-width="3"></circle>
                                <circle class="text-tertiary"
                                        cx="18"
                                        cy="18"
                                        fill="none"
                                        r="14"
                                        stroke="currentColor"
                                        stroke-dasharray="68, 100"
                                        stroke-linecap="round"
                                        stroke-width="3"></circle>
                            </svg>
                            <span class="absolute font-metric-md text-metric-md text-on-surface font-bold">68%</span>
                        </div>
                        <span class="font-code-sm text-[10px] text-tertiary font-semibold">Đỉnh 94% SMT-01</span>
                    </div>
                    <!-- Buffer Cache -->
                    <div class="bg-surface-container-low p-space-sm rounded-lg flex flex-col items-center text-center">
                        <span class="font-label-caps text-label-caps text-outline uppercase font-semibold">Buffer Cache Hit</span>
                        <div class="my-2 relative w-20 h-20 flex items-center justify-center">
                            <svg class="w-full h-full transform -rotate-90" viewbox="0 0 36 36">
                                <circle class="text-surface-container-highest"
                                        cx="18"
                                        cy="18"
                                        fill="none"
                                        r="14"
                                        stroke="currentColor"
                                        stroke-width="3"></circle>
                                <circle class="text-secondary"
                                        cx="18"
                                        cy="18"
                                        fill="none"
                                        r="14"
                                        stroke="currentColor"
                                        stroke-dasharray="98.4, 100"
                                        stroke-linecap="round"
                                        stroke-width="3"></circle>
                            </svg>
                            <span class="absolute font-metric-md text-metric-md text-secondary font-bold">98.4%</span>
                        </div>
                        <span class="font-code-sm text-[10px] text-secondary font-semibold">SLA Tối ưu (&gt;95%)</span>
                    </div>
                    <!-- Disk I/O Queue -->
                    <div class="bg-surface-container-low p-space-sm rounded-lg flex flex-col items-center text-center">
                        <span class="font-label-caps text-label-caps text-outline uppercase font-semibold">Disk I/O Queue</span>
                        <div class="my-2 relative w-20 h-20 flex items-center justify-center">
                            <svg class="w-full h-full transform -rotate-90" viewbox="0 0 36 36">
                                <circle class="text-surface-container-highest"
                                        cx="18"
                                        cy="18"
                                        fill="none"
                                        r="14"
                                        stroke="currentColor"
                                        stroke-width="3"></circle>
                                <circle class="text-primary"
                                        cx="18"
                                        cy="18"
                                        fill="none"
                                        r="14"
                                        stroke="currentColor"
                                        stroke-dasharray="45, 100"
                                        stroke-linecap="round"
                                        stroke-width="3"></circle>
                            </svg>
                            <span class="absolute font-metric-md text-metric-md text-primary font-bold">3.2</span>
                        </div>
                        <span class="font-code-sm text-[10px] text-on-surface-variant font-semibold">Queue Depth (LUNs)</span>
                    </div>
                    <!-- Network Throughput -->
                    <div class="bg-surface-container-low p-space-sm rounded-lg flex flex-col items-center text-center">
                        <span class="font-label-caps text-label-caps text-outline uppercase font-semibold">Network Fleet</span>
                        <div class="my-2 relative w-20 h-20 flex items-center justify-center">
                            <svg class="w-full h-full transform -rotate-90" viewbox="0 0 36 36">
                                <circle class="text-surface-container-highest"
                                        cx="18"
                                        cy="18"
                                        fill="none"
                                        r="14"
                                        stroke="currentColor"
                                        stroke-width="3"></circle>
                                <circle class="text-secondary-fixed-dim"
                                        cx="18"
                                        cy="18"
                                        fill="none"
                                        r="14"
                                        stroke="currentColor"
                                        stroke-dasharray="60, 100"
                                        stroke-linecap="round"
                                        stroke-width="3"></circle>
                            </svg>
                            <span class="absolute font-metric-md text-metric-md text-on-surface font-bold">1.2G</span>
                        </div>
                        <span class="font-code-sm text-[10px] text-secondary font-semibold">Gbps Synced Traffic</span>
                    </div>
                </div>
                <!-- Comparative Load Matrix: FATP vs CR vs SMT -->
                <div class="mt-space-sm bg-surface-container-low p-space-sm rounded-lg">
                    <div class="flex items-center justify-between mb-2">
                        <span class="font-label-caps text-label-caps text-outline uppercase font-semibold">Phân tích tải 3 khu vực (CPU / Memory / IOPS)</span>
                        <span class="font-code-sm text-code-sm text-on-surface-variant">Đồng bộ: 500ms</span>
                    </div>
                    <div class="grid grid-cols-3 gap-space-sm text-center font-code-sm text-code-sm">
                        <div class="bg-surface-container p-2 rounded">
                            <div class="text-on-surface font-bold mb-1">FATP Assembly</div>
                            <div class="text-tertiary">CPU: 74%</div>
                            <div class="text-secondary">RAM: 86%</div>
                            <div class="text-on-surface-variant">IOPS: 12.4k</div>
                        </div>
                        <div class="bg-surface-container p-2 rounded">
