    <!-- CLIENT JAVASCRIPT: FILTERING, TOGGLE MODES & ACTIONS -->
    <script>
        // 1. Dynamic Site Filter Function
        function filterZone(zoneKey) {
            const pills = document.querySelectorAll('.zone-pill');
            pills.forEach((pill) => {
                pill.classList.remove('bg-primary-container', 'text-on-primary-container');
                pill.classList.add('bg-surface-container-high', 'text-on-surface-variant');
            });

            const activePill = document.getElementById('zone-pill-' + zoneKey);
            if (activePill) {
                activePill.classList.remove('bg-surface-container-high', 'text-on-surface-variant');
                activePill.classList.add('bg-primary-container', 'text-on-primary-container');
            }

            const rows = document.querySelectorAll('.alert-row');
            rows.forEach((row) => {
                if (zoneKey === 'ALL' || row.getAttribute('data-zone') === zoneKey) {
                    row.style.display = '';
                } else {
                    row.style.display = 'none';
                }
            });
        }

        // 2. Incident Search Filter
        function searchAlerts() {
            const filter = document.getElementById('alertSearchInput').value.toLowerCase();
            const rows = document.querySelectorAll('.alert-row');
            rows.forEach((row) => {
                const text = row.innerText.toLowerCase();
                row.style.display = text.indexOf(filter) > -1 ? '' : 'none';
            });
        }

        // 3. Modals and Triggers
        function showDeadlockXML() {
            document.getElementById('deadlockModal').classList.remove('hidden');
        }

        function closeDeadlockXML() {
            document.getElementById('deadlockModal').classList.add('hidden');
        }

        function openCompareModal() {
            document.getElementById('compareModal').classList.remove('hidden');
        }

        function closeCompareModal() {
            document.getElementById('compareModal').classList.add('hidden');
        }

        function killSessionPrompt(spid) {
            if (
                confirm(
                    `XÁC NHẬN: Bạn có chắc chắn muốn phát lệnh KILL SPID ${spid} để gỡ Deadlock chuỗi không?`,
                )
            ) {
                alert(
                    `Đã gửi lệnh [KILL ${spid}] tới SQL Instance thành công. Telemetry đang giải phóng tài nguyên...`,
                );
            }
        }

        function openTicket(ticketId) {
            alert(`Đã khởi tạo vé sự cố ${ticketId} trên ITSM ServiceDesk! Phân nhóm: L2 DBA On-call.`);
        }

        function quickShrinkModal(host) {
            alert(`Gửi yêu cầu DBCC SHRINKFILE (Target 15% Free Space) cho Transaction Log tại ${host}`);
        }

        function ackAlert(buttonElement) {
            const row = buttonElement.closest('tr');
            buttonElement.innerText = 'Đã nhận (ACK)';
            buttonElement.disabled = true;
            buttonElement.classList.add('opacity-50');
            if (row) {
                row.classList.remove('bg-error-container/10');
                row.classList.add('opacity-75');
            }
        }

        function exportAlertsCSV() {
            alert('Đang trích xuất 142 sự cố trong 24h qua thành file NOC_Telemetry_Report.csv...');
        }

        // 4. Wallboard NOC TV Mode (Scales and zooms UI for large display)
        let isWallboard = false;
        function toggleWallboardMode() {
            isWallboard = !isWallboard;
            if (isWallboard) {
                if (document.documentElement.requestFullscreen) {
                    document.documentElement.requestFullscreen().catch(() => { });
                }
                alert(
                    'Đã chuyển sang chế độ Wallboard NOC TV Mode (Hiển thị tối ưu trên màn hình lớn 4K/8K)',
                );
            } else {
                if (document.exitFullscreen) {
                    document.exitFullscreen().catch(() => { });
                }
            }
        }
    </script>
</main>
