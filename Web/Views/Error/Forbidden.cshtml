
@{
    Layout = "~/Views/Shared/_Layout_Auth.cshtml";
    ViewBag.Title = "Fobidden";
}

<!-- Soft blur / glowing orbs for depth -->
<div class="absolute -top-32 -left-32 w-96 h-96 bg-sky-200/40 rounded-full blur-3xl pointer-events-none"></div>
<div class="absolute -bottom-32 -right-32 w-96 h-96 bg-indigo-200/40 rounded-full blur-3xl pointer-events-none"></div>
<div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[34rem] h-[34rem] bg-blue-100/30 rounded-full blur-3xl pointer-events-none"></div>

<!-- Content container -->
<div class="relative max-w-xl mx-auto flex flex-col items-center justify-center z-10 text-center">
    <div class="text-8xl md:text-9xl font-extrabold tracking-tight select-none bg-gradient-to-r from-[#eb2525] via-[#dd8547] to-[#dd8547] bg-clip-text text-transparent drop-shadow-sm">403</div>
    <h1 class="text-2xl md:text-3xl font-bold text-slate-800 mt-4 mb-3">Access denied</h1>
    <p class="text-slate-600 text-base md:text-lg leading-relaxed">You don’t have permission to access this resource. Please check your access permissions or verify your identity.</p>
    <!-- Actions -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-3 mt-8">

        @using (Html.BeginForm("Logout", "Auth", FormMethod.Post, new { @class = "inline-flex" }))
        {
            @Html.AntiForgeryToken()

            <button type="submit"
                    class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-xl bg-red-600 hover:bg-red-700 text-white font-semibold shadow-lg shadow-red-600/20 transition-all duration-200 hover:-translate-y-0.5">

                <span class="material-symbols-rounded text-xl">
                    @Html.Icon("logout", "w-[24px] h-[24px] shrink-0")
                </span>

                Log out
            </button>
        }

    </div>
</div>
